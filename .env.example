# =============================================================================
#  Vulkanizer demo — primjer konfiguracije
#  Kopirati u `.env` i popuniti. `.env` je u .gitignore i NE SMIJE se commitati.
# =============================================================================

# --- Baza podataka ---------------------------------------------------------
POSTGRES_DB=vulkanizer
POSTGRES_USER=vulkanizer
# TODO: zamijeniti jakom lozinkom prije bilo kakvog deploya
POSTGRES_PASSWORD=promijeni_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
# Profili: demo (sa seed podacima) | prod
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=8080

# JWT potpisni ključ — HS256, minimalno 32 bajta.
# Generiraj s:  openssl rand -base64 48
# TODO: OBAVEZNO zamijeniti prije produkcije. Nikad ne commitati stvarnu vrijednost.
JWT_SECRET=promijeni_me_generiraj_s_openssl_rand_base64_48
JWT_EXPIRATION_MINUTES=120

# Šalje li se cookie samo preko HTTPS-a. U produkciji MORA biti true.
COOKIE_SECURE=false

# Dozvoljeni izvori za CORS (zarezom odvojeno)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- E-mail dojava o rezervaciji -------------------------------------------
# Ugašeno po defaultu: demo radi bez ijednog vanjskog poslužitelja, a poruka
# koja bi otišla ispiše se u log. Uključivanjem se traže sve vrijednosti ispod —
# ako jedna nedostaje, aplikacija se NE diže (bolje nego da tiho ne šalje).
MAIL_ENABLED=false

# Gmail: lozinka je App Password (https://myaccount.google.com/apppasswords),
# NE lozinka računa, i traži uključenu dvofaktorsku prijavu.
# TODO: nikad ne commitati stvarnu vrijednost.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail prepisuje pošiljatelja, pa MAIL_FROM mora biti isti kao MAIL_USERNAME.
MAIL_FROM=
# Adresa servisa na koju stiže dojava o novoj rezervaciji.
MAIL_SHOP_RECIPIENT=
# Osnova poveznice na portal u tijelu poruke.
MAIL_PORTAL_URL=http://localhost:5173

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# Analytics je u demou isključen. Kad klijent odluči koji alat koristi,
# ovdje ide njegov ID; skripta se učitava tek nakon pristanka na kolačiće.
VITE_ANALYTICS_ID=
